//! NumCore — bare-metal Rust firmware for the LM3S811 (Cortex-M3)
//!
//! Uses UART0 for I/O via QEMU's stdio mapping.
//!
//! Run
//! ───
//!   qemu-system-arm -M lm3s811evb -nographic -serial mon:stdio \
//!     -kernel target/thumbv7m-none-eabi/release/NumCore

#![no_std]
#![no_main]

use core::panic::PanicInfo;
use core::ptr;

// ─── LM3S811 peripheral addresses ────────────────────────────────────────────

const SYSCTL_BASE: u32 = 0x400F_E000;
const UART0_BASE:  u32 = 0x4000_C000;
const GPIOA_BASE:  u32 = 0x4000_4000;

const SYSCTL_RCGC1: u32 = 0x104;
const SYSCTL_RCGC2: u32 = 0x108;

const UART_DR:   u32 = 0x000;
const UART_FR:   u32 = 0x018;
const UART_IBRD: u32 = 0x024;
const UART_FBRD: u32 = 0x028;
const UART_LCRH: u32 = 0x02C;
const UART_CTL:  u32 = 0x030;

const GPIO_AFSEL: u32 = 0x420;
const GPIO_DEN:   u32 = 0x51C;

const UART_FR_TXFF:    u32 = 1 << 5;
const UART_FR_RXFE:    u32 = 1 << 4;
const UART_CTL_UARTEN: u32 = 1 << 0;
const UART_LCRH_WLEN8: u32 = 0b11 << 5;
const UART_LCRH_FEN:   u32 = 1 << 4;

// ─── MMIO ────────────────────────────────────────────────────────────────────

#[inline(always)]
fn mmio_read(base: u32, offset: u32) -> u32 {
    unsafe { ptr::read_volatile((base + offset) as *const u32) }
}

#[inline(always)]
fn mmio_write(base: u32, offset: u32, val: u32) {
    unsafe { ptr::write_volatile((base + offset) as *mut u32, val) }
}

// ─── UART ────────────────────────────────────────────────────────────────────

fn uart_init() {
    mmio_write(SYSCTL_BASE, SYSCTL_RCGC1, mmio_read(SYSCTL_BASE, SYSCTL_RCGC1) | 1);
    mmio_write(SYSCTL_BASE, SYSCTL_RCGC2, mmio_read(SYSCTL_BASE, SYSCTL_RCGC2) | 1);

    // Small delay to let clocks settle
    for _ in 0..10 { unsafe { core::arch::asm!("nop") } }

    mmio_write(GPIOA_BASE, GPIO_AFSEL, 0b11);
    mmio_write(GPIOA_BASE, GPIO_DEN,   0b11);

    mmio_write(UART0_BASE, UART_CTL, 0);

    // 115200 baud @ 12 MHz: IBRD=6, FBRD=33
    mmio_write(UART0_BASE, UART_IBRD, 6);
    mmio_write(UART0_BASE, UART_FBRD, 33);
    mmio_write(UART0_BASE, UART_LCRH, UART_LCRH_WLEN8 | UART_LCRH_FEN);
    mmio_write(UART0_BASE, UART_CTL,  UART_CTL_UARTEN | (1 << 8) | (1 << 9));
}

fn uart_putc(b: u8) {
    while mmio_read(UART0_BASE, UART_FR) & UART_FR_TXFF != 0 {}
    mmio_write(UART0_BASE, UART_DR, b as u32);
}

fn uart_puts(s: &[u8]) {
    for &b in s { uart_putc(b); }
}

/// Blocking UART RX — waits until a byte is available.
fn uart_getc() -> u8 {
    while mmio_read(UART0_BASE, UART_FR) & UART_FR_RXFE != 0 {}
    (mmio_read(UART0_BASE, UART_DR) & 0xFF) as u8
}

// ─── Calculator ───────────────────────────────────────────────────────────────

fn evaluate(input: &[u8]) -> Option<i32> {
    let mut i = 0;
    let len = input.len();
    while i < len && input[i] == b' ' { i += 1; }
    let (mut acc, n) = parse_int(&input[i..])?;
    i += n;
    loop {
        while i < len && input[i] == b' ' { i += 1; }
        if i >= len { break; }
        let op = input[i];
        if !matches!(op, b'+' | b'-' | b'*' | b'/') { return None; }
        i += 1;
        while i < len && input[i] == b' ' { i += 1; }
        let (rhs, n) = parse_int(&input[i..])?;
        i += n;
        acc = match op {
            b'+' => acc.checked_add(rhs)?,
            b'-' => acc.checked_sub(rhs)?,
            b'*' => acc.checked_mul(rhs)?,
            b'/' => { if rhs == 0 { return None; } acc.checked_div(rhs)? }
            _    => return None,
        };
    }
    Some(acc)
}

fn parse_int(s: &[u8]) -> Option<(i32, usize)> {
    let mut i = 0;
    let neg = if s.first() == Some(&b'-') { i += 1; true } else { false };
    if i >= s.len() || !s[i].is_ascii_digit() { return None; }
    let mut v = 0i32;
    while i < s.len() && s[i].is_ascii_digit() {
        v = v.checked_mul(10)?.checked_add((s[i] - b'0') as i32)?;
        i += 1;
    }
    Some((if neg { -v } else { v }, i))
}

fn fmt_i32(n: i32, buf: &mut [u8; 12]) -> &[u8] {
    if n == 0 { buf[0] = b'0'; return &buf[..1]; }
    let neg = n < 0;
    let mut tmp = if neg { (n as i64).unsigned_abs() as u32 } else { n as u32 };
    let mut end = 11usize;
    while tmp > 0 { end -= 1; buf[end] = b'0' + (tmp % 10) as u8; tmp /= 10; }
    if neg { end -= 1; buf[end] = b'-'; }
    &buf[end..]
}

fn read_line(buf: &mut [u8; 64]) -> usize {
    let mut pos = 0usize;
    loop {
        let c = uart_getc();
        match c {
            b'\r' | b'\n' => { uart_puts(b"\r\n"); return pos; }
            0x08 | 0x7F   => { if pos > 0 { pos -= 1; uart_puts(b"\x08 \x08"); } }
            0x20..=0x7E   => { if pos < buf.len() - 1 { buf[pos] = c; pos += 1; uart_putc(c); } }
            _             => {}
        }
    }
}

// ─── Main ────────────────────────────────────────────────────────────────────

fn main() -> ! {
    uart_init();

    uart_puts(b"\r\n");
    uart_puts(b"================================\r\n");
    uart_puts(b"  NumCore  v0.1\r\n");
    uart_puts(b"  LM3S811  Cortex-M3  (Rust)\r\n");
    uart_puts(b"================================\r\n");
    uart_puts(b"Operators: + - * /\r\n\r\n");

    let mut buf = [0u8; 64];
    loop {
        uart_puts(b"> ");
        let len = read_line(&mut buf);
        let line = &buf[..len];
        if !line.iter().any(|&b| b != b' ') { continue; }
        match evaluate(line) {
            Some(r) => {
                uart_puts(b"= ");
                let mut nb = [0u8; 12];
                uart_puts(fmt_i32(r, &mut nb));
                uart_puts(b"\r\n");
            }
            None => uart_puts(b"! invalid expression or division by zero\r\n"),
        }
    }
}

// ─── Vector table & startup ──────────────────────────────────────────────────

#[no_mangle]
pub unsafe extern "C" fn Reset() -> ! {
    extern "C" {
        static _sbss: u8; static _ebss: u8;
        static _sdata: u8; static _edata: u8; static _sidata: u8;
    }
    let bss_start = &_sbss  as *const u8 as *mut u8;
    let bss_len   = (&_ebss as *const u8).offset_from(&_sbss) as usize;
    ptr::write_bytes(bss_start, 0, bss_len);

    let data_start = &_sdata  as *const u8 as *mut u8;
    let data_len   = (&_edata as *const u8).offset_from(&_sdata) as usize;
    ptr::copy_nonoverlapping(&_sidata as *const u8, data_start, data_len);

    main()
}

#[no_mangle] pub unsafe extern "C" fn DefaultHandler() -> ! { loop {} }

#[link_section = ".vector_table.reset_vector"]
#[no_mangle]
pub static RESET_VECTOR: unsafe extern "C" fn() -> ! = Reset;

#[link_section = ".vector_table.exceptions"]
#[no_mangle]
pub static EXCEPTIONS: [Option<unsafe extern "C" fn() -> !>; 14] = [
    Some(DefaultHandler), Some(DefaultHandler), Some(DefaultHandler),
    Some(DefaultHandler), Some(DefaultHandler), None, None, None, None,
    Some(DefaultHandler), Some(DefaultHandler), None,
    Some(DefaultHandler), Some(DefaultHandler),
];

#[panic_handler]
fn panic(_: &PanicInfo) -> ! {
    uart_puts(b"\r\n*** PANIC ***\r\n");
    loop {}
}

// test